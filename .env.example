NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://jungle:jungle@localhost:5432/wagering
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_NAME=wager-transactions
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_BACKOFF_BASE_SECONDS=5
SQS_BACKOFF_MAX_SECONDS=300

OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000

PENDING_REFERENCE_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_BACKOFF_BASE_MS=5000
PENDING_REFERENCE_BACKOFF_MAX_MS=300000

AUTH_ENABLED=false
CORS_ORIGINS=
