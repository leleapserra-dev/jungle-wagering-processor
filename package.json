{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --external @mikro-orm/* --external @aws-sdk/* --external pino --external prom-client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migration:up": "bun src/scripts/migrate.ts up",
    "migration:down": "bun src/scripts/migrate.ts down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:e2e": "bun test test/e2e",
    "test:cov": "bun test --coverage",
    "test:load": "bun test test/load"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@types/pino-http": "^5.8.4",
    "ajv": "^8.17.1",
    "decimal.js": "^10.4.3",
    "nestjs-pino": "^5.3.1",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mikro-orm/nestjs": "^6.0.0",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
